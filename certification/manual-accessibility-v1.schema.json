{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulTiffany/MeTTafy/certification/manual-accessibility-v1.schema.json",
  "title": "MeTTafy manual accessibility evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "reviewed_at_utc",
    "reviewer",
    "standard",
    "pages",
    "checks",
    "axe_incomplete_adjudications",
    "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "affiliation": {"type": ["string", "null"]},
        "assistive_technology_experience": {"type": ["string", "null"]}
      }
    },
    "standard": {"const": "WCAG 2.2 AA"},
    "pages": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "zoom_reflow", "screen_reader", "color_contrast"],
      "properties": {
        "keyboard": {"$ref": "#/$defs/check"},
        "zoom_reflow": {"$ref": "#/$defs/check"},
        "screen_reader": {"$ref": "#/$defs/check"},
        "color_contrast": {"$ref": "#/$defs/check"}
      }
    },
    "axe_incomplete_adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "page", "target", "result", "evidence"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "page": {"type": "string", "minLength": 1},
          "target": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "result": {"enum": ["pass", "fail", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": ["string", "null"]},
    "result": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence"],
      "properties": {
        "result": {"enum": ["pass", "fail"]},
        "evidence": {"type": "string", "minLength": 1},
        "tools": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
